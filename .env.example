# ── Supabase (Required for production) ──────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret-from-supabase-settings"

# ── Database ────────────────────────────────────────────────────────
# For local dev (SQLite — zero setup):
DATABASE_URL="sqlite:///./farming_assistant.db"
# For Supabase Postgres (production):
# DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres"

# ── External APIs ───────────────────────────────────────────────────
OPENWEATHER_API_KEY="your-openweathermap-api-key"

# ── LLM Provider (set one of the below) ─────────────────────────────
# Set LLM_PROVIDER to switch between models — no code changes needed
LLM_PROVIDER="gemini"              # Options: gemini | anthropic

# Gemini (Google)
GOOGLE_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"    # Optional: override default model

# Anthropic (Claude)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"  # Optional: override default model

# Tavily (Live Web Search)
TAVILY_API_KEY="your-tavily-api-key"

# ── Optional ────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY="change-this-in-production"