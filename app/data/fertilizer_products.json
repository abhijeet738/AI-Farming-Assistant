  "application_guidelines": {
    "soil_testing": {
      "importance": "Essential for determining nutrient requirements",
      "parameters": ["pH", "organic carbon", "available N, P, K", "micronutrients"],
      "frequency": "Once every 2-3 years or before each crop season"
    },
    "timing": {
      "basal_application": "At the time of sowing/transplanting",
      "top_dressing": "During active growth stages",
      "foliar_application": "During critical growth stages or nutrient deficiency"
    },
    "methods": {
      "broadcasting": "Uniform spreading over the field surface",
      "band_placement": "Placement in bands near the seed/plant row",
      "side_dressing": "Application beside the plant rows during growth",
      "foliar_spray": "Application on leaf surface as liquid solution"
    },
    "precautions": [
      "Avoid fertilizer burn by maintaining proper distance from seeds/plants",
      "Ensure adequate soil moisture before and after application",
      "Do not apply during hot sunny hours for foliar sprays",
      "Store fertilizers in cool, dry places away from moisture",
      "Use protective equipment during handling and application"
    ]
  },
  "nutrient_management": {
    "4r_principles": {
      "right_source": "Select appropriate fertilizer based on crop and soil needs",
      "right_rate": "Apply optimal quantity based on soil test and crop requirement",
      "right_time": "Apply at the right growth stage for maximum uptake",
      "right_place": "Place fertilizer where roots can easily access"
    },
    "integrated_approach": [
      "Combine organic and inorganic sources",
      "Use bio-fertilizers to enhance nutrient availability",
      "Practice crop rotation to maintain soil fertility",
      "Adopt precision agriculture techniques"
    ]
  }
