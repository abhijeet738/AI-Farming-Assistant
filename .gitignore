# Backend-specific .gitignore

# Environment variables
.env
.env.local
.env.production
.env.development

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
.venv/

# ML Models (these are large files)
# ml_models/**/*.pkl
# ml_models/**/*.joblib
# ml_models/**/*.pth
# ml_models/**/*.pt
# ml_models/**/*.h5
# ml_models/**/*.model
# ml_models/**/*.bin
# ml_models/**/*.onnx

# Keep the directory structure but ignore model files
!ml_models/*/
!ml_models/*/.gitkeep

# Database
*.db
*.sqlite
*.sqlite3
instance/

# Logs
*.log
logs/
app.log

# Cache
.cache/
.pytest_cache/

# Coverage
.coverage
htmlcov/
coverage.xml

# Temporary files
*.tmp
*.temp
*.bak

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter notebooks (if any)
*.ipynb
.ipynb_checkpoints/

# Data files (large datasets)
data/*.csv
data/*.json
data/*.parquet
data/*.xlsx

# Keep data directory structure
!data/
!data/.gitkeep

# Test outputs
test_outputs/
test_results/

# Alembic (database migrations)
alembic/versions/*.py
!alembic/versions/
!alembic/versions/.gitkeep

# FastAPI uploads
uploads/
temp_uploads/

# Performance profiling
*.prof
*.pstats

# Documentation build
docs/_build/test_farming_assistant.db*
